# Copia este archivo como ".env" y rellénalo. NO lo compartas ni lo subas a git.

# Cuenta de NewHotel que usará la sincronización automática (recomendado: un usuario
# dedicado, sin doble factor, solo con permisos de consulta).
NEWHOTEL_EMAIL=
NEWHOTEL_PASSWORD=

# ID del hotel en NewHotel (opcional: si se deja vacío se usa el del token o el primero de la cuenta)
NEWHOTEL_HOTEL_ID=

# Opcionales
# SYNC_INTERVAL_MIN=10
# PORT=3000
# HOTEL_TZ=America/Lima
