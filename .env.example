# Copia este archivo como ".env" y rellénalo. NO lo compartas ni lo subas a git.

# Cuenta de NewHotel que usará la sincronización automática (recomendado: un usuario
# dedicado, sin doble factor, solo con permisos de consulta).
NEWHOTEL_EMAIL=
NEWHOTEL_PASSWORD=

# ID del hotel en NewHotel (opcional: si se deja vacío se usa el del token o el primero de la cuenta)
NEWHOTEL_HOTEL_ID=

# Opcionales
# SYNC_INTERVAL_MIN=10
# PORT=3000
# HOTEL_TZ=America/Lima

# Acceso a la web
# AUTH_MODE=open            -> sin login: entra cualquiera desde ALLOWED_NETWORKS (servidor del hotel)
#                              (vacío = cada trabajador entra con su usuario de NewHotel)
# ALLOWED_NETWORKS=192.168.1.0/24,192.168.1.50
#                           -> IPs o redes que pueden abrir la app. En modo open, vacío = la red del servidor
# OPEN_USER_NAME=Recepción  -> nombre que se muestra arriba en modo open
# COOKIE_SECURE=1           -> solo si se sirve por HTTPS

# Copia de seguridad diaria de la base
# BACKUP_DIR=D:\RespaldoPMS\copias
# BACKUP_KEEP_DAYS=30
